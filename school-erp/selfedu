});
teachers
Schema::create('teachers', function (Blueprint $table) {
    $table->id();
    $table->foreignId('user_id')->constrained()->onDelete('cascade');
    $table->string('qualification');
    $table->decimal('salary', 10, 2);
    $table->timestamps();
