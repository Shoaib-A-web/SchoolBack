STEP 4: DEFINE MIGRATIONS
students table
Schema::create('students', function (Blueprint $table) {
    $table->id();
    $table->foreignId('user_id')->constrained()->onDelete('cascade');
    $table->foreignId('class_room_id')->constrained();
    $table->string('roll_number');
    $table->date('dob');
